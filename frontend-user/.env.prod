# 生产环境 Docker 配置文件
# 容器配置
CONTAINER_NAME=frontend-user-prod
PORT=80
NETWORK_NAME=prod-network

# 镜像配置
IMAGE_NAME=frontend-user
IMAGE_TAG=prod-latest

# 环境变量
ENV=prod
DEBUG=false
LOG_LEVEL=warn

# 资源限制
CPU_LIMIT=2.0
MEMORY_LIMIT=2G

# 生产环境特有配置
HEALTHCHECK_INTERVAL=10s
HEALTHCHECK_RETRIES=5
RESTART_POLICY=always
