# ============================================
# 环境变量配置示例文件
# 使用方法：
#   1. 复制此文件为 .env
#   2. 根据实际环境修改配置值
#   3. docker-compose 会自动加载 .env 文件
# ============================================

# ============================================
# 通用配置
# ============================================

# 环境名称：development / testing / production
ENV_NAME=development

# API 基础地址（根据环境修改）
API_BASE_URL=http://localhost:3000

# ============================================
# Nginx 配置
# ============================================

# Nginx 监听端口
NGINX_PORT=80

# 是否启用静态资源缓存：true / false
CACHE_ENABLED=false

# 是否启用 gzip 压缩：true / false
GZIP_ENABLED=false

# ============================================
# Docker 配置
# ============================================

# 容器名称前缀
CONTAINER_PREFIX=frontend-user

# 外部访问端口
EXTERNAL_PORT=8080

# ============================================
# 构建配置
# ============================================

# 构建平台
BUILDPLATFORM=linux/amd64

# Docker 镜像标签
IMAGE_TAG=latest

# ============================================
# 日志配置
# ============================================

# 日志级别：debug / info / warn / error
LOG_LEVEL=info

# 日志文件最大大小
LOG_MAX_SIZE=10m

# 日志文件保留数量
LOG_MAX_FILE=3
