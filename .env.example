# ============================================
# 环境变量配置示例文件
# 使用说明：
# 1. 复制此文件为对应环境的 .env 文件
# 2. 根据实际情况修改配置值
# 3. 不要将 .env 文件提交到版本控制
# ============================================

# ============================================
# 通用配置
# ============================================

# 项目名称
COMPOSE_PROJECT_NAME=watermark-remover

# Docker镜像仓库地址
DOCKER_REGISTRY=ghcr.io

# Docker镜像名称
DOCKER_IMAGE_NAME=watermark-remover-frontend

# ============================================
# 开发环境配置
# ============================================

# 开发环境端口
DEV_PORT=8081

# 开发环境API地址
DEV_API_BASE_URL=http://localhost:3000/api

# 开发环境调试模式
DEV_DEBUG=true

# ============================================
# 测试环境配置
# ============================================

# 测试环境端口
TEST_PORT=8082

# 测试环境API地址
TEST_API_BASE_URL=http://test-api.example.com/api

# 测试环境调试模式
TEST_DEBUG=false

# ============================================
# 生产环境配置
# ============================================

# 生产环境端口
PROD_PORT=80

# 生产环境API地址
PROD_API_BASE_URL=https://api.example.com/api

# 生产环境调试模式
PROD_DEBUG=false

# ============================================
# Docker 资源配置
# ============================================

# CPU限制
CPU_LIMIT=1.0

# 内存限制
MEMORY_LIMIT=1G

# CPU保留
CPU_RESERVATION=0.5

# 内存保留
MEMORY_RESERVATION=512M
