# ============================================
# 测试环境配置
# 适用于测试服务器
# ============================================

# 环境标识
ENV_NAME=testing

# API 地址（测试环境）
API_BASE_URL=http://api-test.example.com

# Nginx 配置
NGINX_PORT=80
CACHE_ENABLED=true
GZIP_ENABLED=true

# 容器配置
CONTAINER_PREFIX=frontend-user-test
EXTERNAL_PORT=8081

# 日志配置
LOG_LEVEL=info
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
