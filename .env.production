# ============================================
# 生产环境配置
# 适用于生产服务器
# ============================================

# 环境标识
ENV_NAME=production

# API 地址（生产环境，使用HTTPS）
API_BASE_URL=https://api.example.com

# Nginx 配置
NGINX_PORT=80
CACHE_ENABLED=true
GZIP_ENABLED=true

# 容器配置
CONTAINER_PREFIX=frontend-user-prod
EXTERNAL_PORT=80

# 日志配置
LOG_LEVEL=warn
LOG_MAX_SIZE=10m
LOG_MAX_FILE=5

# 生产环境安全配置
# 注意：生产环境的敏感信息应该使用密钥管理服务
# 不要将真实的密钥提交到版本控制系统
