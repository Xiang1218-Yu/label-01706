# ============================================
# 开发环境配置
# 适用于本地开发调试
# ============================================

# 环境标识
ENV_NAME=development

# API 地址（开发环境指向本地后端）
API_BASE_URL=http://localhost:3000

# Nginx 配置
NGINX_PORT=80
CACHE_ENABLED=false
GZIP_ENABLED=false

# 容器配置
CONTAINER_PREFIX=frontend-user-dev
EXTERNAL_PORT=8080

# 日志配置
LOG_LEVEL=debug
LOG_MAX_SIZE=50m
LOG_MAX_FILE=5
